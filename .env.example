# Copy to .env and fill in. Never share this file: the API keys give full control of Radarr/Sonarr.

# Bot token from https://discord.com/developers/applications (Bot > Reset Token).
DISCORD_TOKEN=

# Channel where review cards with Delete/Decline buttons are posted. Keep it private to admins.
# The slash commands are registered in this channel's server.
ADMIN_CHANNEL_ID=

# Roles allowed to press Delete/Decline and run /pendingdeletions (comma-separated IDs).
# Server members with Administrator or Manage Server can always do this.
ADMIN_ROLE_IDS=

# Roles allowed to request deletions (comma-separated IDs). Leave empty to let everyone request.
REQUESTER_ROLE_IDS=

# Your server's IP and the Radarr/Sonarr ports. Not localhost: inside the container that is the container itself.
RADARR_URL=http://192.168.1.50:7878
RADARR_API_KEY=
SONARR_URL=http://192.168.1.50:8989
SONARR_API_KEY=

# Optional
# true = Radarr/Sonarr also add an exclusion so import lists (Trakt, Plex watchlist) don't re-add the title.
ADD_IMPORT_EXCLUSION=false
# true = go through the motions without deleting anything. Handy for a first test.
DRY_RUN=false
